1. ARRAY CREATION
────────────────────────────────────────────────────────────────────────────

I. np.array — np.array(object, dtype=None)
              — object → input data | dtype → desired data type
              — Creates a NumPy array.

II. np.arange — np.arange(start, stop, step=1, dtype=None)
                — start → first value | stop → end (excluded) | step → increment | dtype → data type
                — Creates evenly spaced values using a fixed step.

III. np.linspace — np.linspace(start, stop, num=50, endpoint=True, dtype=None)
                   — start → first value | stop → last value | num → number of values | endpoint → include stop or not | dtype → data type
                   — Creates evenly spaced values by specifying the number of values.

IV. np.logspace — np.logspace(start, stop, num=50, base=10)
                  — start → starting exponent | stop → ending exponent | num → number of values | base → logarithm base
                  — Creates logarithmically spaced values.

V. np.zeros — np.zeros(shape, dtype=float)
              — shape → array dimensions | dtype → data type
              — Creates an array filled with zeros.

VI. np.ones — np.ones(shape, dtype=float)
             — shape → array dimensions | dtype → data type
             — Creates an array filled with ones.

VII. np.empty — np.empty(shape, dtype=float)
                — shape → array dimensions | dtype → data type
                — Creates an uninitialized array.

VIII. np.full — np.full(shape, fill_value, dtype=None)
                — shape → array dimensions | fill_value → value to fill | dtype → data type
                — Creates an array filled with a specified value.

IX. np.eye — np.eye(N, M=None, k=0, dtype=float)
             — N → rows | M → columns | k → diagonal offset | dtype → data type
             — Creates an identity-like matrix.

X. np.identity — np.identity(n, dtype=float)
                 — n → size of square matrix | dtype → data type
                 — Creates a square identity matrix.

XI. np.tri — np.tri(N, M=None, k=0, dtype=float)
             — N → rows | M → columns | k → diagonal offset
             — Creates a lower triangular matrix.

XII. np.triu — np.triu(array, k=0)
               — array → input array | k → diagonal offset
               — Returns the upper triangular part of an array.

XIII. np.tril — np.tril(array, k=0)
                — array → input array | k → diagonal offset
                — Returns the lower triangular part of an array.

XIV. np.zeros_like — np.zeros_like(array, dtype=None)
                     — array → reference array | dtype → override data type (optional)
                     — Creates a zero-filled array with the same shape.

XV. np.empty_like — np.empty_like(array, dtype=None)
                    — array → reference array | dtype → override data type (optional)
                    — Creates an uninitialized array with the same shape.


